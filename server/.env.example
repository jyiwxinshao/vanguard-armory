HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=game_store
DB_USER=root
DB_PASSWORD=

# Only needed when creating demo accounts. Use your own local passwords.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Authentication requires a random secret of at least 32 bytes. setup:env generates it locally.
JWT_SECRET=
JWT_EXPIRES_IN=2h
